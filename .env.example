# Sandbox only — never commit real provider secrets.
PAYMENT_MODE=sandbox
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Games: one technical integration only.
# Use mock while developing; switch to aggregator only after contracting a provider.
GAME_INTEGRATION=mock
AGGREGATOR_MODE=sandbox
AGGREGATOR_BASE_URL=
AGGREGATOR_API_KEY=
AGGREGATOR_WEBHOOK_SECRET=

# Optional labels/filters for studios supplied by the aggregator.
# Example: pragmatic,pgsoft,tada
AGGREGATOR_STUDIOS=pragmatic,pgsoft,tada

# Real-money mode remains blocked until every production gate is satisfied
# and REAL_MONEY_CODE_READY is explicitly enabled in reviewed server code.
REAL_MONEY_MODE_ENABLED=false
BETTING_OPERATOR_AUTHORIZED=false
BETTING_OPERATOR_BRAND_DOMAIN=
A33F_PLAYER_SESSION_SECRET=
DATABASE_URL=
LEDGER_MODE=sandbox
WALLET_MODE=sandbox
KYC_MODE=sandbox
GEOLOCATION_MODE=sandbox
SELF_EXCLUSION_MODE=sandbox
PROHIBITED_PERSONS_CHECK_MODE=sandbox
AML_MODE=sandbox
RESPONSIBLE_GAMING_LIMITS_REQUIRED=false
GAME_CERTIFICATION_ENFORCED=false
