WALLET_MODE=sandbox
KYC_MODE=sandbox
GEOLOCATION_MODE=sandbox
SELF_EXCLUSION_MODE=sandbox
PROHIBITED_PERSONS_CHECK_MODE=sandbox
AML_MODE=sandbox
