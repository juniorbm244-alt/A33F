# Sandbox only — never commit real provider secrets.
PAYMENT_MODE=sandbox
# When a real provider is selected, keep its secret in your hosting provider's secret manager.
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Game provider integration.
# Keep mock/sandbox until the operator, provider and games are authorized/certified for the target jurisdiction.
GAME_PROVIDER=mock
GAME_PROVIDER_MODE=sandbox
GAME_PROVIDER_BASE_URL=
GAME_PROVIDER_API_KEY=
GAME_PROVIDER_WEBHOOK_SECRET=
